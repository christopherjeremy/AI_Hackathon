# RideWise Assist Environment Configuration Example
# Copy this file to .env and fill in the values provided by the hackathon organizers.

# LLM Configuration (NeoStats Azure OpenAI)
AZURE_OPENAI_ENDPOINT=https://your-resource-name.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_MODEL_NAME=gpt-oss-120b
AZURE_OPENAI_DEPLOYMENT_NAME=Neo-Hackathon

# Hugging Face Embeddings Configuration (Top MTEB Retrieval Model)
# Add your Hugging Face User Access Token (from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Database Configuration
DATABASE_PATH=Neostats Hackathon AI Usecase/ridewise.db

# Policy Documents Directory
POLICIES_DIR=Neostats Hackathon AI Usecase

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
